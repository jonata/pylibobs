index 711c09b..d564253 100644
--- a/shared/media-playback/CMakeLists.txt
+++ b/shared/media-playback/CMakeLists.txt
@@ -1,6 +1,9 @@
 cmake_minimum_required(VERSION 3.28...3.30)
 
-find_package(FFmpeg REQUIRED avcodec avdevice avutil avformat)
+find_package(
+  FFmpeg
